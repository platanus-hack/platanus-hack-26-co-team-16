# .env.example — plantilla versionada. Cópiala a `.env` y rellena la key:
#
#     cp .env.example .env
#
# `.env` está en el .gitignore ("Secretos — NUNCA commitear llaves"); este
# archivo sí se commitea, por eso NUNCA lleva un valor real.
#
# ---------------------------------------------------------------------------
# IMPORTANTE: nada del repo carga este archivo solo.
#
# No hay `python-dotenv` en requirements.txt y el Makefile no hace `source`.
# El .env es para TU shell: cárgalo antes de correr cualquier cosa.
#
#     set -a; source .env; set +a          # bash / zsh (también Git Bash)
#     Get-Content .env | Where-Object { $_ -match '^\s*[^#].*=' } | ForEach-Object {
#         $k,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($k.Trim(), $v.Trim())
#     }                                     # PowerShell
# ---------------------------------------------------------------------------


# === 1. La única credencial del proyecto ====================================
#
# Quién la lee: el SDK de Anthropic, instanciado en `behavior/cliente.py`
# (`anthropic.Anthropic()` resuelve la key desde el entorno, no se le pasa).
#
# Es OPCIONAL. Sin ella el cliente cae al caché en disco de `behavior/.cache/`,
# y si el prompt tampoco está cacheado lanza `SinCredenciales`. Toda la ruta de
# $0 —`make test`, la ablación determinista, `?modo=reglas` en la interfaz— no
# la necesita para nada.
#
# La necesitas para: `make servidor` en modo LLM y `python -m behavior.demo --llm`.
# Sácala de https://console.anthropic.com/settings/keys (empieza con `sk-ant-`).
#
# El tope de gasto NO se configura acá: es duro y vive en el código
# (`behavior/presupuesto.py`, TOPE_POR_DEFECTO_USD = 3.00 USD por corrida).
ANTHROPIC_API_KEY=


# === 2. Frontend ============================================================
#
# Quién la lee: `web/enjambre/next.config.mjs`, para reescribir `/api/*` hacia
# la API de Python y esquivar CORS.
#
# El valor de abajo ES el default que ya trae el código: en local no hace falta
# tocarlo. Solo cambia en deploy, cuando la API no está en localhost.
#
# OJO: Next.js lee su entorno desde SU carpeta, no desde la raíz del repo. Para
# que el `next dev` lo tome sin exportarlo a mano, va en
# `web/enjambre/.env.local`, no acá.
ENJAMBRE_API=http://localhost:8000


# === 3. Makefile ============================================================
#
# `SEED` es una variable `?=` del Makefile: si está en el entorno, gana sobre el
# default. 42 es el default, así que esta línea no cambia nada — está para dejar
# la palanca a la vista. Otro seed: `make run SEED=7`.
SEED=42

# `PY` (el intérprete) NO se pone acá a propósito. El Makefile lo autodetecta
# (`.venv/bin/python3` si existe, si no `python3`), y una variable de entorno
# vacía rompería esa detección. Para forzarlo: `make run PY=/ruta/a/python3`.
